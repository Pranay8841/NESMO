# Environment Variables for NESMO React Native Android App
# Copy this file to .env and fill in your values

# API Configuration
# For emulator: http://10.0.2.2:5000/api
# For physical device: http://192.168.x.x:5000/api (replace with your machine's IP)
# For production: https://api.yourdomain.com/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# Firebase Configuration (Get from Firebase Console)
# https://console.firebase.google.com → Project Settings
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Google OAuth Client IDs (Get from Google Cloud Console → Credentials)
# Web Client ID - used for web/iOS auth flows
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id
# Android Client ID - created with your app's package name + SHA-1 fingerprint
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id

# Razorpay Configuration (for payment integration)
# Get these from your Razorpay dashboard
EXPO_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
